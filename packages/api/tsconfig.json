{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Environment
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],

    // JSX
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    // Output
    "outDir": "./dist"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
